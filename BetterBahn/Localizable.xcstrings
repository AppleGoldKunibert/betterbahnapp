        }
      }
    },
    "Zeigt die Wettervorhersage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the weather forecast"
          }
        }
      }
    },
    "Zeigt dir, wie pünktlich ein Zug in den letzten 30 Tagen war und wie oft er ausfiel oder das Gleis wechselte." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows you how punctual a train was over the last 30 days and how often it was cancelled or changed platform."
          }
        }
      }
    },
    "Zeigt in der Reise das Wetter bei Ankunft und bei längeren Umstiegen. Dafür wird nur der Bahnhof verschickt, nie dein Standort." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the weather on arrival and for longer changes in the journey. Only the station is sent for this, never your location."
          }
        }
      }
    },
    "Zeigt in der Suche die Flagge vor dem Bahnhof, auf Wunsch nur bei Bahnhöfen im Ausland. Mit einer Flagge hinter dem Namen siehst du nur Bahnhöfe aus diesem Land." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the flag in front of the station in the search, or only for stations abroad if you like. With a flag after the name, you only see stations from that country."
          }
        }
      }
    },
