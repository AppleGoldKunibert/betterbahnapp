    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit deine Reisen im Kalender stehen und bei Verspätungen und Gleiswechseln aktuell bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So your journeys appear in your calendar and stay up to date with delays and platform changes."
